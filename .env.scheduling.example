# Merge into your existing .env; do not replace your AI/voice settings.
# Generate once: .venv/bin/python -c 'import secrets; print(secrets.token_urlsafe(32))'
JARVIS_SCHEDULER_TOKEN=
JARVIS_SCHEDULER_OWNER=sultan
JARVIS_TIMEZONE=Europe/London
JARVIS_SCHEDULER_ENABLED=true
# Optional: absolute path on a durable local volume (never a temporary directory).
# JARVIS_SCHEDULER_DB=/path/to/persistent/scheduling.sqlite3
